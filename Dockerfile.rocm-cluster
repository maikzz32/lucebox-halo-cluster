# syntax=docker/dockerfile:1.7

# ─── lucebox-halo-cluster: ROCm 10 / gfx1151 / RCCL-over-RoCE image ─────────
#
# Multi-node sibling of Dockerfile.rocm. One image serves as BUILD and RUNTIME
# base for every rank of the expert-parallel DeepSeek V4 cluster (see
# server/docs/CLUSTER.md). It differs from Dockerfile.rocm in three ways:
#
#   1. ROCm comes from AMD's TheRock pip SDK (ROCm 10.x, gfx1151 kernels for
#      RCCL included), NOT from rocm/dev-ubuntu:6.4.1. The 6.4.x userspace can
#      segfault at model load against a ROCm 7.x+ host driver (Dockerfile.rocm
#      header); the Strix Halo nodes run Fedora 45 with kernel 7.2 amdgpu, so
#      the userspace must be at least as new as the driver. Rule of thumb:
#      keep the SDK major version >= the host driver's.
#   2. RDMA userspace (rdma-core, ibverbs/rdmacm utils, perftest) and OpenMPI
#      (for multi-node rccl-tests) are installed; rccl-tests is built into
#      /opt/rccl-tests/bin.
#   3. Lucebox is configured with -DDFLASH27B_CLUSTER=ON (RCCL enabled for
#      HIP) and the binaries live in /opt/lucebox/bin.
#
# Two ways to obtain the ROCm SDK layer, selected by ROCM_SDK_FROM_PIP:
#
#   ROCM_SDK_FROM_PIP=0 (default, fast path): reuse BASE_IMAGE, which already
#       carries the TheRock SDK at /opt/rocm (the user's vLLM image
#       ghcr.io/maikzz32/strix-vllm-gfx1151:dev-rocm10, Fedora 44, ROCm 10.0.0,
#       RCCL 2.30.4, hipcc, gcc 16.2, ninja - but no cmake).
#   ROCM_SDK_FROM_PIP=1 (reproducible path): start from fedora:44 and install
#       the SDK with pip exactly like /home/maik/strix-halo-vllm-cluster/
#       docker/Dockerfile.fedora does:
#         pip install --index-url https://repo.amd.com/rocm/whl-multi-arch/ \
#             "rocm[devel,libraries,device-gfx1151]==${ROCM_VERSION}"
#         python3 -m rocm_sdk init && ln -s "$(rocm_sdk path --root)" /opt/rocm
#
# Canonical invocations (see docker-bake.hcl / Makefile):
#   docker buildx bake rocm-cluster-local --load
#   ROCM_SDK_FROM_PIP=1 docker buildx bake rocm-cluster-local --load
#   podman build -f Dockerfile.rocm-cluster --target base .      # CI: Dockerfile validity, no GPU
#
# NOTE: /dev/kfd, /dev/dri and /dev/infiniband are wired in at run time
# (scripts/cluster/launch_cluster.sh). Nothing here needs a GPU to build.

ARG BASE_IMAGE=ghcr.io/maikzz32/strix-vllm-gfx1151:dev-rocm10
ARG ROCM_SDK_FROM_PIP=0
ARG ROCM_VERSION=10.0.0
ARG FEDORA_VERSION=44
ARG DFLASH_HIP_ARCHES="gfx1151"
# rccl-tests git ref. Pin to a commit for reproducible baselines
# (`RCCL_TESTS_REF=<sha> docker buildx bake rocm-cluster-local`).
ARG RCCL_TESTS_REPO=https://github.com/ROCm/rccl-tests.git
ARG RCCL_TESTS_REF=develop

# ─── SDK layer, variant 0: prebuilt image already carrying /opt/rocm ─────────
FROM ${BASE_IMAGE} AS sdk-pip-0
# Nothing to do: /opt/rocm (+ /opt/rocm-core, /opt/rocm-libraries) exist.
RUN test -x /opt/rocm/bin/hipcc \
    || (echo "ERROR: BASE_IMAGE has no /opt/rocm/bin/hipcc; set ROCM_SDK_FROM_PIP=1 to install the SDK." >&2 && exit 1)

# ─── SDK layer, variant 1: TheRock pip SDK into a clean Fedora ──────────────
FROM registry.fedoraproject.org/fedora:${FEDORA_VERSION} AS sdk-pip-1
ARG ROCM_VERSION
# python3.12 is what TheRock wheels and the user's Dockerfile.fedora use; the
# Fedora default python3 may be newer, so install the 3.12 stack explicitly.
RUN dnf install -y --setopt=install_weak_deps=False \
        python3.12 python3.12-devel python3-pip gcc gcc-c++ glibc-devel \
        libdrm-devel numactl-libs libatomic \
    && dnf clean all \
    && python3.12 -m ensurepip --upgrade || true \
    && python3.12 -m pip install --no-cache-dir --upgrade pip
# `rocm[devel,libraries,device-gfx1151]` = HIP toolchain (hipcc, clang), math
# libraries (rocblas/hipblas/hipcub/rocprim/rocwmma) and RCCL with gfx1151
# device code (stock TheRock supports gfx1151: ROCm/TheRock#4935, #5376).
RUN python3.12 -m pip install --no-cache-dir \
        --index-url https://repo.amd.com/rocm/whl-multi-arch/ \
        "rocm[devel,libraries,device-gfx1151]==${ROCM_VERSION}" \
    && python3.12 -m rocm_sdk init \
    && ln -sfn "$(python3.12 -m rocm_sdk path --root)" /opt/rocm \
    && test -x /opt/rocm/bin/hipcc

# ─── Stage: base (toolchain + RDMA + MPI; no Lucebox sources yet) ───────────
# `--target base` is what cluster-ci.yml builds on PRs to validate this file.
FROM sdk-pip-${ROCM_SDK_FROM_PIP} AS base
ARG ROCM_VERSION

# PATH order matters: /usr/bin must come BEFORE /opt/rocm/lib/llvm/bin. When
# ROCm's clang++ is first, CMake picks it as the HOST C++ compiler and the link
# fails with "unable to find library -lstdc++" (verified in the dev-rocm10
# image). Host compiler is gcc/g++; HIP device code goes through
# /opt/rocm/lib/llvm/bin/clang++ via CMAKE_HIP_COMPILER (see the cmake calls).
ENV ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    PATH=/usr/bin:/usr/lib64/openmpi/bin:/opt/rocm/bin:/opt/rocm/lib/llvm/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/rocm/lib:/usr/lib64/openmpi/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}

# Host tools. cmake is NOT in the dev-rocm10 image; dnf is the first choice,
# `pip install cmake` the fallback (the pip wheel is a plain static binary).
# openmpi + openmpi-devel: multi-node rccl-tests need an mpirun that can ssh
# into the peer containers. Fedora puts OpenMPI under /usr/lib64/openmpi
# (PATH/LD_LIBRARY_PATH above) instead of using environment modules.
# rdma-core / libibverbs-utils / librdmacm-utils / perftest: RCCL dlopens
# libibverbs from INSIDE the container, so the container's rdma-core must
# support the host NICs. Intel E810 (nodes 1-3) works with the Fedora 44
# package; the E830 on StrixHalo4 needs rdma-core >= v64 (Fedora 44 ships
# v61) - see the version check below and server/docs/CLUSTER.md.
RUN dnf install -y --setopt=install_weak_deps=False \
        ninja-build git git-lfs gcc gcc-c++ libstdc++-devel glibc-devel make pkgconf-pkg-config \
        rdma-core rdma-core-devel libibverbs libibverbs-utils librdmacm librdmacm-utils \
        perftest infiniband-diags \
        openmpi openmpi-devel openssh-clients \
        jq curl rsync procps-ng iproute hostname findutils which \
        libcurl-devel libgomp pciutils \
        python3 python3-pip \
    && (dnf install -y --setopt=install_weak_deps=False cmake \
        || python3 -m pip install --no-cache-dir cmake) \
    && dnf clean all \
    && cmake --version && ninja --version && mpirun --version | head -1

# rdma-core version report (informational; E830 needs >= 64). The build does
# not fail here because nodes 1-3 (E810) are fine with older versions.
RUN v="$(rpm -q --qf '%{VERSION}' rdma-core 2>/dev/null || echo 0)"; \
    echo "rdma-core in image: ${v}"; \
    if [ "${v%%.*}" -lt 64 ] 2>/dev/null; then \
        echo "WARNING: rdma-core ${v} < 64: the Intel E830 (StrixHalo4) irdma provider needs >= v64." >&2; \
        echo "         Nodes 1-3 (E810) are unaffected. See server/docs/CLUSTER.md, Troubleshooting." >&2; \
    fi

# Sanity: the pieces Lucebox's HIP build and RCCL link against.
RUN test -f /opt/rocm/include/rccl/rccl.h || test -f /opt/rocm/include/rccl.h \
    || (echo "ERROR: rccl.h not found under /opt/rocm/include" >&2 && exit 1); \
    ls /opt/rocm/lib/librccl.so* /opt/rocm/lib/libhipblas.so* /opt/rocm/lib/librocblas.so* >/dev/null

# RCCL / NCCL hardening defaults measured on the 4-node Strix Halo RoCE v2
# cluster (see server/docs/CLUSTER.md, "RCCL environment"). All overridable at
# `podman run -e`. Interface/HCA/GID are NOT baked in: they differ per node
# and are exported by dflash_server from --cluster-ifname/--cluster-ib-hca/
# --cluster-gid-index (cluster_config.h export_rccl_environment).
#   NCCL_NET_GDR_LEVEL=0      gfx1151 has no GPUDirect RDMA; bounce via host RAM
#                             (same DRAM on Strix Halo, so it is a memcpy).
#   NCCL_IB_DISABLE=0         force the IB/RoCE transport (never fall back to TCP silently)
#   NCCL_IB_QPS_PER_CONNECTION=2, NCCL_IB_TIMEOUT=22, NCCL_IB_RETRY_CNT=7
#                             tolerate RoCE without PFC: 11.7 M all-reduces in 15 min without hang
#   NCCL_ASYNC_ERROR_HANDLING=1  surface async comm errors instead of hanging
#   HIP_FORCE_DEV_KERNARG=1   kernarg in device memory (Strix Halo perf default)
ENV NCCL_NET_GDR_LEVEL=0 \
    NCCL_IB_DISABLE=0 \
    NCCL_IB_QPS_PER_CONNECTION=2 \
    NCCL_IB_TIMEOUT=22 \
    NCCL_IB_RETRY_CNT=7 \
    NCCL_ASYNC_ERROR_HANDLING=1 \
    HIP_FORCE_DEV_KERNARG=1

# ─── Stage: rccl-tests ──────────────────────────────────────────────────────
FROM base AS rccl-tests
ARG RCCL_TESTS_REPO
ARG RCCL_TESTS_REF
ARG DFLASH_HIP_ARCHES
WORKDIR /src
RUN git clone --depth 1 --branch "${RCCL_TESTS_REF}" "${RCCL_TESTS_REPO}" rccl-tests 2>/dev/null \
    || (git clone "${RCCL_TESTS_REPO}" rccl-tests && git -C rccl-tests checkout "${RCCL_TESTS_REF}")
# rccl-tests README: CXX=hipcc cmake -DCMAKE_PREFIX_PATH=<rccl> -DUSE_MPI=ON -DMPI_PATH=<mpi>
# GPU_TARGETS limits device code to our gfx list (default builds every arch).
RUN cd rccl-tests \
    && CXX=/opt/rocm/bin/hipcc cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_HIP_COMPILER=/opt/rocm/lib/llvm/bin/clang++ \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DGPU_TARGETS="${DFLASH_HIP_ARCHES}" \
        -DUSE_MPI=ON \
        -DMPI_PATH=/usr/lib64/openmpi \
    && cmake --build build --parallel \
    && mkdir -p /opt/rccl-tests/bin \
    && find build -maxdepth 2 -type f -perm -u+x -name '*_perf' -exec cp {} /opt/rccl-tests/bin/ \; \
    && test -x /opt/rccl-tests/bin/all_reduce_perf \
    && ls /opt/rccl-tests/bin

# ─── Stage: builder (Lucebox with DFLASH27B_CLUSTER=ON) ─────────────────────
FROM base AS builder
ARG DFLASH_HIP_ARCHES
WORKDIR /src

# COPY ordering mirrors Dockerfile.rocm: C++ inputs first so the slow HIP
# build layer stays cached across Python/doc-only edits.
COPY server/CMakeLists.txt /src/server/CMakeLists.txt
COPY server/cmake /src/server/cmake
COPY server/include /src/server/include
COPY server/src /src/server/src
COPY server/test /src/server/test
COPY server/hip_compat /src/server/hip_compat
COPY server/deps /src/server/deps
COPY server/share /src/server/share

RUN test -f /src/server/deps/llama.cpp/ggml/CMakeLists.txt \
    || (echo "ERROR: missing vendored ggml sources at server/deps/llama.cpp/ggml in the docker build context." >&2 \
        && exit 1)

# Cluster build. Compared with Dockerfile.rocm:
#   -DDFLASH27B_CLUSTER=ON        multi-node RCCL expert-parallel (turns GGML_HIP_RCCL on)
#   -DGGML_HIP_GRAPHS=ON          HIP graph replay for the fused decode/verify graphs
#   -DDFLASH27B_ROCMFP2_AFFINE=ON ROCMFPX affine decode tables (target GGUF is ROCMFPX)
#   CMAKE_C/CXX_COMPILER=gcc/g++ + CMAKE_HIP_COMPILER=ROCm clang++: verified recipe
#                                 for the dev-rocm10 image (see PATH note in stage base)
#   CMAKE_POSITION_INDEPENDENT_CODE=ON + CMAKE_HIP_FLAGS=-fPIC: g++ emits non-PIE
#                                 objects while ROCm's clang links PIE; without
#                                 these the final dflash_server link dies with
#                                 "ld.lld: relocation R_X86_64_32S cannot be used
#                                 against local symbol; recompile with -fPIC" (verified)
# BSA stays OFF (CUDA-only kernels); FA_ALL_QUANTS OFF keeps fattn tractable.
# CMAKE_BUILD_WITH_INSTALL_RPATH bakes $ORIGIN-relative rpaths so the pruned
# build tree can be moved to /opt/lucebox/bin as a unit.
RUN cmake -S /src/server -B /src/server/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_PREFIX_PATH=/opt/rocm \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_CXX_COMPILER=g++ \
        -DCMAKE_HIP_COMPILER=/opt/rocm/lib/llvm/bin/clang++ \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_HIP_FLAGS=-fPIC \
        -DDFLASH27B_GPU_BACKEND=hip \
        -DDFLASH27B_HIP_ARCHITECTURES="${DFLASH_HIP_ARCHES}" \
        -DDFLASH27B_CLUSTER=ON \
        -DGGML_HIP_GRAPHS=ON \
        -DDFLASH27B_ROCMFP2_AFFINE=ON \
        -DDFLASH27B_ENABLE_BSA=OFF \
        -DDFLASH27B_FA_ALL_QUANTS=OFF \
    && cmake --build /src/server/build --target dflash_server test_cluster_unit test_feature_gate --parallel

# GPU-free unit tests run at image build time; a failing cluster protocol /
# gate test must never produce an image.
RUN cd /src/server/build && ./test_cluster_unit && ./test_feature_gate

# Prune to the binaries plus the ggml shared libs their $ORIGIN rpath needs.
RUN cd /src/server/build \
    && find . -mindepth 1 -maxdepth 1 \
            ! -name dflash_server ! -name test_cluster_unit ! -name test_feature_gate \
            ! -name deps ! -name share -exec rm -rf {} + \
    && find deps -mindepth 1 -type f ! -name 'lib*.so*' -delete \
    && find deps -depth -type d -empty -delete

# ─── Stage: runtime ─────────────────────────────────────────────────────────
FROM base AS runtime

ARG GIT_SHA=""
ARG IMAGE_TAG=""
ARG BUILD_TIME=""

COPY --from=rccl-tests /opt/rccl-tests /opt/rccl-tests
COPY --from=builder /src/server/build /opt/lucebox/bin
COPY share/model_cards /opt/lucebox/share/model_cards
COPY scripts/cluster /opt/lucebox/scripts/cluster

RUN test -x /opt/lucebox/bin/dflash_server \
    && test -x /opt/lucebox/bin/test_cluster_unit \
    && test -x /opt/lucebox/bin/test_feature_gate \
    && test -x /opt/rccl-tests/bin/all_reduce_perf \
    && chmod +x /opt/lucebox/scripts/cluster/*.sh \
    && printf '%s\n%s\n%s\n' "$GIT_SHA" "$IMAGE_TAG" "$BUILD_TIME" > /opt/lucebox/IMAGE_INFO

# ld.so fallback in case a binary is invoked through a path that defeats the
# $ORIGIN rpath (e.g. copied out of /opt/lucebox/bin).
RUN printf '%s\n%s\n%s\n' \
        /opt/lucebox/bin/deps/llama.cpp/ggml/src \
        /opt/lucebox/bin/deps/llama.cpp/ggml/src/ggml-hip \
        /opt/rocm/lib \
        > /etc/ld.so.conf.d/lucebox-cluster.conf \
    && ldconfig

ENV PATH=/opt/lucebox/bin:/opt/rccl-tests/bin:${PATH} \
    DFLASH_SERVER_BIN=/opt/lucebox/bin/dflash_server \
    DFLASH_IMAGE_INFO_PATH=/opt/lucebox/IMAGE_INFO \
    DFLASH_MODEL_CARDS_DIR=/opt/lucebox/share/model_cards

# Models are bind-mounted read-only at /models by launch_cluster.sh.
VOLUME ["/models"]
EXPOSE 8016 9400

# Run example for ONE rank (launch_cluster.sh does this for every node):
#   podman run -d --name lucebox-rank0 --network host --ipc host \
#     --device /dev/kfd --device /dev/dri --device /dev/infiniband \
#     --group-add keep-groups --security-opt seccomp=unconfined \
#     --security-opt label=disable --pids-limit -1 --ulimit memlock=-1:-1 \
#     --add-host StrixHalo1:192.168.100.1 ... \
#     -v /home/maik/gguf/ds4:/models:ro \
#     -e DFLASH_DS4_SPEC=1 -e DFLASH_DS4_DRAFT=/models/<dspark>.gguf \
#     ghcr.io/maikzz32/lucebox-halo-cluster:dev /models/<target>.gguf \
#       --cluster-rank 0 --cluster-size 2 --cluster-head 192.168.100.1:9400 \
#       --cluster-ifname enp197s0f3np3 --cluster-ib-hca rocep197s0f3 --cluster-gid-index 1 \
#       --target-device hip:0 --host 0.0.0.0 --port 8016
# Override the entrypoint for tools: `--entrypoint all_reduce_perf` or
# `--entrypoint bash`.
ENTRYPOINT ["/opt/lucebox/bin/dflash_server"]
